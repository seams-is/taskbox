<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The runner loop, in ci's login session.
     It loads in every Aqua session; the loop exits at once for any user but ci.
     The environment is only PATH. No telemetry variable is set. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.taskbox.loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/taskbox/bin/bun</string>
    <string>--no-install</string>
    <string>--no-env-file</string>
    <string>--cwd=/</string>
    <string>--config=/opt/taskbox/app/bunfig.run.toml</string>
    <string>/opt/taskbox/app/src/cli.ts</string>
    <string>loop</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/taskbox/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
